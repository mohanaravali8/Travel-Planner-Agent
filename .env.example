# Environment Configuration for Atlas Travel Planner
# Copy this file to .env and fill in your values

# ─────────────────────────────────────────────────────────────────
# IBM CLOUD CONFIGURATION (Required for AI features)
# ─────────────────────────────────────────────────────────────────
# Get your API key from: https://cloud.ibm.com/iam/apikeys
IBM_API_KEY=_GQLr2JlQhgEMwPEq7jvSIo3AmjwvysM_8spxaNjMaVI
# Get your Project ID from: https://dataplatform.cloud.ibm.com/projects/
IBM_PROJECT_ID=f88595ac-6dcf-493d-bbe2-4699b4a42d6c

# Watsonx.ai URL (keep as-is for US South region)
IBM_WATSONX_URL=https://au-syd.ml.cloud.ibm.com

# ─────────────────────────────────────────────────────────────────
# FLASK CONFIGURATION
# ─────────────────────────────────────────────────────────────────
# Generate a secure key: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=your_super_secret_flask_key_here

FLASK_DEBUG=False
FLASK_PORT=5000

# ─────────────────────────────────────────────────────────────────
# OPTIONAL: WEATHER API (Free tier)
# ─────────────────────────────────────────────────────────────────
# Get a free key at: https://openweathermap.org/api
# (App works with mock weather data if not provided)
WEATHER_API_KEY=your_openweathermap_api_key_here
